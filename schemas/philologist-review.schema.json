{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Antiokh/humanizer_russian/schemas/philologist-review.schema.json",
  "title": "humanizer_russian independent philologist review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer", "review_date", "case_reviews", "overall_notes"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "qualification", "affiliation_or_independent", "conflict_of_interest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "qualification": {"type": "string", "minLength": 1},
        "affiliation_or_independent": {"type": "string", "minLength": 1},
        "conflict_of_interest": {"type": "string"}
      }
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "case_reviews": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "primary_class",
          "verdict",
          "confidence",
          "reason",
          "preferred_variant",
          "normative_source",
          "counterexample",
          "notes"
        ],
        "properties": {
          "case_id": {"type": "string", "pattern": "^PHIL-(0[1-9]|1[0-9]|2[0-8])$"},
          "primary_class": {
            "enum": [
              "LANGUAGE_ERROR",
              "NORMATIVE_VARIANT",
              "MARKED_BUT_ACCEPTABLE",
              "NATIVE_PREFERENCE",
              "EDITING_PREFERENCE",
              "AUTHOR_DEPENDENT",
              "NEEDS_CONTEXT",
              "NEEDS_CORPUS",
              "NEEDS_NORM_SOURCE"
            ]
          },
          "verdict": {"enum": ["KEEP", "CHANGE", "REVIEW", "NEEDS_VERIFICATION"]},
          "confidence": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "reason": {"type": "string", "minLength": 1},
          "preferred_variant": {"type": "string"},
          "normative_source": {"type": "string"},
          "counterexample": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "overall_notes": {"type": "string"}
  }
}
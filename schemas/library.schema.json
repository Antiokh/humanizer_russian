{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "library.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "display_name",
    "source_namespace",
    "source_type",
    "source_branch",
    "reviewer_id",
    "adapter",
    "linter_path",
    "enabled_by_default",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "source_namespace": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["project_core", "book", "style_guide", "corpus", "other"]},
    "source_branch": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["legacy_lint_v1", "review_v1"]},
    "linter_path": {"type": "string", "minLength": 1},
    "enabled_by_default": {"type": "boolean"},
    "status": {"enum": ["INGESTED", "READ", "EXTRACTED", "TRACEABLE", "EVALUATED", "AUDITED", "OPERATIONAL"]},
    "references": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}

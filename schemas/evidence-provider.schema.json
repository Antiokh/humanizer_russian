{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-provider.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "display_name", "status", "evidence_type", "adapter", "enabled_by_default", "network_required", "failure_policy", "timeout_ms", "description"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROJECT", "OPERATIONAL", "DISABLED"]},
    "evidence_type": {"enum": ["CORPUS_USAGE", "SPOKEN_USAGE", "LEXICAL_PRAGMATICS", "NORMATIVE_REFERENCE", "PARSED_CORPUS", "RESEARCH_EVIDENCE"]},
    "adapter": {"const": "evidence_v1"},
    "enabled_by_default": {"type": "boolean"},
    "network_required": {"type": "boolean"},
    "failure_policy": {"enum": ["SKIP", "ERROR"]},
    "timeout_ms": {"type": "integer", "minimum": 25, "maximum": 10000},
    "module_path": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "OPERATIONAL"}}, "required": ["status"]},
      "then": {"required": ["module_path"]}
    },
    {
      "if": {"properties": {"status": {"const": "PROJECT"}}, "required": ["status"]},
      "then": {
        "properties": {
          "enabled_by_default": {"const": false}
        }
      }
    }
  ],
  "additionalProperties": false
}

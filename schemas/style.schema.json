{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "display_name", "description", "reviewer_weights", "conflict_policy", "preserve_author_voice", "default_reviewers"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "reviewer_weights": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "conflict_policy": {"enum": ["show_alternatives", "weighted_majority", "preserve_original"]},
    "preserve_author_voice": {"type": "boolean"},
    "default_reviewers": {"type": "array", "items": {"type": "string"}},
    "preferences": {"type": "object"}
  },
  "additionalProperties": true
}

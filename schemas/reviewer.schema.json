{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "display_name", "short_label", "review_label", "kind", "domains", "disclaimer"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "short_label": {"type": "string", "minLength": 1},
    "review_label": {"type": "string", "minLength": 1},
    "kind": {"enum": ["project_core", "book_author", "style_guide", "corpus", "other"]},
    "avatar": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["path", "license", "source"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "license": {"type": "string", "minLength": 1},
            "source": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      ]
    },
    "domains": {"type": "array", "items": {"type": "string"}},
    "disclaimer": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

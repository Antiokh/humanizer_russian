{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Antiokh/humanizer_russian/blob/main/profiles/schema.json",
  "title": "humanizer_russian author profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "corpus",
    "lexicon",
    "syntax",
    "punctuation",
    "stance",
    "observed_errors",
    "settings"
  ],
  "properties": {
    "version": {"const": 1},
    "author": {"type": "string"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "words", "sentences"],
      "properties": {
        "documents": {"type": "integer", "minimum": 0},
        "words": {"type": "integer", "minimum": 0},
        "sentences": {"type": "integer", "minimum": 0},
        "paragraphs": {"type": "integer", "minimum": 0}
      }
    },
    "lexicon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discourse_markers", "self_repair_markers", "code_switching", "ngrams"],
      "properties": {
        "discourse_markers": {
          "type": "array",
          "items": {"$ref": "#/$defs/rateItem"}
        },
        "self_repair_markers": {
          "type": "array",
          "items": {"$ref": "#/$defs/rateItem"}
        },
        "code_switching": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latin_token_count", "latin_token_rate", "top_latin_tokens"],
          "properties": {
            "latin_token_count": {"type": "integer", "minimum": 0},
            "latin_token_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "top_latin_tokens": {
              "type": "array",
              "items": {"$ref": "#/$defs/countItem"}
            }
          }
        },
        "top_content_tokens": {
          "type": "array",
          "items": {"$ref": "#/$defs/countItem"}
        },
        "sentence_starts": {
          "type": "array",
          "items": {"$ref": "#/$defs/countItem"}
        },
        "ngrams": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bigrams", "trigrams"],
          "properties": {
            "bigrams": {
              "type": "array",
              "items": {"$ref": "#/$defs/countItem"}
            },
            "trigrams": {
              "type": "array",
              "items": {"$ref": "#/$defs/countItem"}
            }
          }
        }
      }
    },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sentence_length",
        "short_le_4_rate",
        "sentences_without_verb_proxy_rate",
        "first_person_sentence_rate",
        "proxy_warning"
      ],
      "properties": {
        "sentence_length": {"$ref": "#/$defs/distribution"},
        "paragraph_length_sentences": {"$ref": "#/$defs/distribution"},
        "short_le_4_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "sentences_without_verb_proxy_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "first_person_sentence_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "question_sentence_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "conjunction_start_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "repeated_first_token_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "proxy_warning": {"type": "string"}
      }
    },
    "punctuation": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/metricItem"}
    },
    "rhetoric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrast_markers",
        "question_answer_proxy_count",
        "question_answer_proxy_per_100_sentences",
        "proxy_warning"
      ],
      "properties": {
        "contrast_markers": {
          "type": "array",
          "items": {"$ref": "#/$defs/rateItem"}
        },
        "question_answer_proxy_count": {"type": "integer", "minimum": 0},
        "question_answer_proxy_per_100_sentences": {"type": "number", "minimum": 0},
        "proxy_warning": {"type": "string"}
      }
    },
    "stance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hedges", "certainty"],
      "properties": {
        "hedges": {"type": "array", "items": {"$ref": "#/$defs/rateItem"}},
        "certainty": {"type": "array", "items": {"$ref": "#/$defs/rateItem"}}
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_terms": {"$ref": "#/$defs/stringList"},
        "generation_terms": {"$ref": "#/$defs/stringList"},
        "professional_terms": {"$ref": "#/$defs/stringList"},
        "preferred": {"$ref": "#/$defs/stringList"},
        "avoid": {"$ref": "#/$defs/stringList"},
        "notes": {"$ref": "#/$defs/stringList"}
      }
    },
    "observed_errors": {
      "type": "array",
      "items": {"type": "object"}
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imitate_errors", "correct_norm_errors"],
      "properties": {
        "imitate_errors": {"const": false},
        "correct_norm_errors": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "countItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "count"],
      "properties": {
        "text": {"type": "string"},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "rateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "count", "per_10k_words"],
      "properties": {
        "text": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "per_10k_words": {"type": "number", "minimum": 0}
      }
    },
    "metricItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "per_10k_words"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "per_10k_words": {"type": "number", "minimum": 0}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p25", "median", "p75", "p90"],
      "properties": {
        "p25": {"type": "number", "minimum": 0},
        "median": {"type": "number", "minimum": 0},
        "p75": {"type": "number", "minimum": 0},
        "p90": {"type": "number", "minimum": 0}
      }
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
